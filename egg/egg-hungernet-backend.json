{
  "_comment": "HungerNet Backend",
  "meta": {
    "version": "PTDL_v2",
    "update_url": null
  },
  "name": "HungerNet Backend",
  "author": "support@hungernet.dev",
  "description": "FastAPI backend for the HungerNet Platform.",
  "features": null,
  "docker_images": {
    "Python 3.13": "ghcr.io/ptero-eggs/yolks:python_3.13",
    "Python 3.12": "ghcr.io/ptero-eggs/yolks:python_3.12"
  },
  "file_denylist": [],
  "startup": "cd /home/container/backend && export PATH=\"/home/container/.local/bin:$PATH\" && uv run uvicorn app.main:app --host 0.0.0.0 --port {{SERVER_PORT}} --proxy-headers --forwarded-allow-ips '*'",
  "config": {
    "files": "{}",
    "startup": "{\r\n    \"done\": \"Uvicorn running on\"\r\n}",
    "logs": "{}",
    "stop": "^C"
  },
  "scripts": {
    "installation": {
      "container": "python:3.12-bookworm",
      "entrypoint": "bash",
      "script": "#!/bin/bash\nset -e\n\napt update\napt install -y git curl\n\nmkdir -p /mnt/server\ncd /mnt/server\n\nrm -rf source\n\ngit clone https://github.com/HungerNet/Platform.git source\n\ncp -r source/* .\ncp -r source/.[!.]* . 2>/dev/null || true\n\nrm -rf source\n\ncd backend\n\nexport HOME=/mnt/server\n\ncurl -LsSf https://astral.sh/uv/install.sh | sh\nexport PATH=\"$HOME/.local/bin:$PATH\"\n\nuv sync\nuv run alembic upgrade head\n\necho \"Install complete\"\nexit 0"
    }
  },
  "variables": [
    {
      "name": "Database URL",
      "description": "PostgreSQL connection string.",
      "env_variable": "DATABASE_URL",
      "default_value": "postgresql+asyncpg://hungernet:local-development-only@localhost:5432/hungernet",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string",
      "field_type": "text"
    },
    {
      "name": "JWT Secret",
      "description": "JWT secret.",
      "env_variable": "JWT_SECRET",
      "default_value": "",
      "user_viewable": false,
      "user_editable": true,
      "rules": "required|string|min:32",
      "field_type": "text"
    },
    {
      "name": "JWT Algorithm",
      "description": "JWT algorithm.",
      "env_variable": "JWT_ALGORITHM",
      "default_value": "HS256",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string",
      "field_type": "text"
    },
    {
      "name": "Access Token Expiry Minutes",
      "description": "Access token lifetime.",
      "env_variable": "ACCESS_TOKEN_EXPIRY_MINUTES",
      "default_value": "15",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|integer",
      "field_type": "text"
    },
    {
      "name": "Session Expiry Days",
      "description": "Session lifetime.",
      "env_variable": "SESSION_EXPIRY_DAYS",
      "default_value": "90",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|integer",
      "field_type": "text"
    },
    {
      "name": "Redis URL",
      "description": "Redis connection string.",
      "env_variable": "REDIS_URL",
      "default_value": "redis://localhost:6379/0",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string",
      "field_type": "text"
    },
    {
      "name": "Vite API Proxy Target",
      "description": "Frontend API proxy target.",
      "env_variable": "VITE_API_PROXY_TARGET",
      "default_value": "http://localhost:8000",
      "user_viewable": true,
      "user_editable": true,
      "rules": "nullable|string",
      "field_type": "text"
    },
    {
      "name": "Avatar Storage Directory",
      "description": "Avatar storage path.",
      "env_variable": "AVATAR_STORAGE_DIR",
      "default_value": "media",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string",
      "field_type": "text"
    },
    {
      "name": "Avatar Public Base URL",
      "description": "Avatar public URL base.",
      "env_variable": "AVATAR_PUBLIC_BASE_URL",
      "default_value": "https://api.hungernet.dev",
      "user_viewable": true,
      "user_editable": true,
      "rules": "nullable|string",
      "field_type": "text"
    },
    {
      "name": "Superuser ID",
      "description": "Superuser ID.",
      "env_variable": "SUPERUSER_ID",
      "default_value": "hungernet",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string",
      "field_type": "text"
    },
    {
      "name": "Superuser Username",
      "description": "Superuser username.",
      "env_variable": "SUPERUSER_USERNAME",
      "default_value": "HungerNet",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string",
      "field_type": "text"
    },
    {
      "name": "Superuser Password",
      "description": "Used when running setup-superuser manually.",
      "env_variable": "SUPERUSER_PASSWORD",
      "default_value": "",
      "user_viewable": false,
      "user_editable": true,
      "rules": "nullable|string",
      "field_type": "text"
    },
    {
      "name": "Postgres Database",
      "env_variable": "POSTGRES_DB",
      "default_value": "hungernet",
      "user_viewable": true,
      "user_editable": true,
      "rules": "nullable|string",
      "field_type": "text"
    },
    {
      "name": "Postgres User",
      "env_variable": "POSTGRES_USER",
      "default_value": "hungernet",
      "user_viewable": true,
      "user_editable": true,
      "rules": "nullable|string",
      "field_type": "text"
    },
    {
      "name": "Postgres Password",
      "env_variable": "POSTGRES_PASSWORD",
      "default_value": "",
      "user_viewable": false,
      "user_editable": true,
      "rules": "nullable|string",
      "field_type": "text"
    }
  ]
}
